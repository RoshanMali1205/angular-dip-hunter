{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon-india.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/manifest-india.webmanifest",
          "/robots.txt",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/*",
          "/icons-default/*",
          "/icons-india/*",
          "/assets/**/*",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "translations",
      "urls": ["/assets/i18n/**"],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "7d",
        "strategy": "freshness"
      }
    },
    {
      "name": "quotes-api",
      "urls": ["/.netlify/functions/quotes*", "/api/quotes*"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "4h",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "ai-api",
      "urls": ["/.netlify/functions/ai*", "/api/ai*"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "0u",
        "timeout": "30s",
        "strategy": "freshness"
      }
    }
  ]
}
